---
import Barber from '../../../components/Barber.astro';
import Base from '../../../layouts/Base.astro';
import ModuleCard from '../../../components/ModuleCard.astro';
import Interested from '../../../components/Interested.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';
import { site } from '../../../i18n/site';
import { getModules } from '../../../lib/modules';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = site[lang];
const modules = getModules(lang);
const types = ['intro', 'input', 'case', 'activity', 'reflection'] as const;
---
<Base lang={lang} path="modules" title={c.modules.title}>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <Barber as="h1" class="h1" text={c.modules.title} />
        <p class="lead">{c.modules.lead}</p>
        <ul class="cpoints">
          {c.modules.points.map((x) => <li><strong>{x.title}</strong><span>{x.text}</span></li>)}
        </ul>
        <ul class="legend" aria-label={t('module.session')}>
          {types.map((x) => <li><span class={`sw t-${x}`}></span>{t(`step.${x}`)}</li>)}
        </ul>
      </div>
      <div class="grid">
        {modules.map(({ module }) => <ModuleCard module={module} lang={lang} />)}
      </div>
    </div>
  </section>
  <Interested lang={lang} />
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; max-width: 980px; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .section-head { max-width: 980px; }
  .cpoints { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 8px 0; }
  .cpoints li { display: grid; gap: 6px; padding-left: 16px; border-left: 6px solid var(--ink); }
  .cpoints strong { font-size: 18px; }
  .cpoints span { font-size: 15px; line-height: 1.45; }
  @media (max-width: 800px) { .cpoints { grid-template-columns: 1fr; } }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; font-weight: 700; }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .sw { width: 22px; height: 12px; border: 1.5px solid var(--ink); border-radius: 3px; }
</style>
