---
import Barber from '../../components/Barber.astro';
import Base from '../../layouts/Base.astro';
import Blob from '../../components/Blob.astro';
import Arrow from '../../components/Arrow.astro';
import { asset, langs, localePath, useTranslations, type Lang } from '../../i18n/ui';
import { site } from '../../i18n/site';
import Interested from '../../components/Interested.astro';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = site[lang];
const p = c.program;
const people = c.about;
---
<Base lang={lang} path="program" title={p.title} description={p.lead}>
  <section class="intro">
    <img class="figure fig" src={asset('cia-graphic-2.png')} alt="" width="419" height="652" />
    <div class="wrap">
      <Barber as="h1" class="h1" text={p.title} />
      <Blob class="lead-blob">
        <p class="lead"><strong>{p.lead}</strong></p>
      </Blob>
      <div class="read desc">{p.description.map((x) => <p>{x}</p>)}</div>
    </div>
  </section>

  <!-- Phases recap -->
  <section class="section phases-sec">
    <div class="wrap">
      <ol class="track" aria-label={c.phases.title}>
        {c.phases.items.map((ph, i) => (
          <li class={`seg seg${i + 1}`}>
            <span class="label">{ph.label} · {ph.when}</span>
            <Barber as="strong" class="no-gap flat" text={ph.title} />
          </li>
        ))}
        <li class="seg seg-end"><span class="label">✓</span><Barber as="strong" class="no-gap flat" text={c.phases.end.title} /></li>
      </ol>
    </div>
  </section>

  <section class="section pt0">
    <div class="wrap cols">
      <div class="paper">
        <Barber class="h2 sm on-paper" text={p.objectivesTitle} />
        <ul class="arrow-list obj">{p.objectives.map((o) => <li>{o}</li>)}</ul>
      </div>
      <div class="paper">
        <Barber class="h2 sm on-paper" text={p.targetTitle} />
        {p.target.map((x) => <p>{x}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head">
        <Barber class="h2" text={p.outcomesTitle} />
        <p class="lead">{p.outcomesLead}</p>
      </div>
      <ol class="outcomes">
        {p.outcomes.map((o, i) => (
          <li>
            <details>
              <summary><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="o">{o.outcome}</span><span class="pl" aria-hidden="true">+</span></summary>
              <dl>
                <div><dt>{t('module.content')}</dt><dd>{o.content}</dd></div>
                <div><dt>{t('module.methods')}</dt><dd>{o.methods}</dd></div>
                <div><dt>{t('module.evaluation')}</dt><dd>{o.evaluation}</dd></div>
              </dl>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><Barber class="h2" text={p.featuresTitle} /></div>
      <ul class="features">
        {p.features.map((f, i) => (
          <li class={`card f${i % 4}`}><h3 class="h3">{f.title}</h3><p>{f.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head"><Barber class="h2" text={people.peopleTitle} /></div>
      <ul class="people">
        {people.people.map((x) => <li><Barber as="strong" class="ptitle" text={x.title} /><p>{x.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div>
        <Barber class="h2 sm" text={p.durationTitle} />
        <ol class="dur">
          {p.duration.map((d) => <li><strong>{d.activity}</strong><span class="chip chip--yellow">{d.when}</span></li>)}
        </ol>
      </div>
      <div>
        <Barber class="h2 sm" text={p.materialsTitle} />
        <ul class="mats paper">
          {p.materials.map((m) => <li><span>{m.name}</span><em>{m.form}</em></li>)}
        </ul>
        <a class="btn btn--ghost mt" href={localePath(lang, 'modules')}>{t('cta.modules')} <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head"><Barber class="h2" text={p.evaluationTitle} /></div>
      <div class="evals">{p.evaluation.map((e, i) => <div><span class="n">{i + 1}</span><p>{e}</p></div>)}</div>
    </div>
  </section>
  <Interested lang={lang} />
</Base>

<style>
  .people { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .ptitle { font-size: clamp(26px, 3vw, 38px); margin-bottom: 12px; }
  .people p { color: rgba(255,255,255,.85); }
  @media (max-width: 860px) { .people { grid-template-columns: 1fr; } }
  .intro { position: relative; padding: clamp(40px, 6vw, 72px) 0 24px; overflow: hidden; }
  .fig { position: absolute; right: max(-40px, calc(50% - 760px)); top: 40px; width: clamp(160px, 17vw, 240px); }
  @media (max-width: 1100px) { .fig { display: none; } }
  .lead-blob { max-width: 820px; margin: 28px 0 32px -12px; --rot: -1deg; }
  .desc p { font-size: 19px; }
  .pt0 { padding-top: 0; }

  .track { list-style: none; display: flex; gap: 6px; }
  .seg { border: var(--border); border-radius: 8px; padding: 16px 18px; display: grid; gap: 4px; box-shadow: var(--shadow-sm); }
  .seg strong { font-size: clamp(22px, 3vw, 34px); font-weight: 900; text-transform: uppercase; line-height: 1; }
  .seg :global(.barber) { font-size: clamp(20px, 2.6vw, 32px); }
  .seg1 { flex: 1; background: var(--yellow); }
  .seg2 { flex: 4; background: var(--blue); color: #fff; }
  .seg3 { flex: 1; background: var(--peach); }
  .seg-end { flex: 1.2; background: var(--lime); }
  @media (max-width: 700px) { .track { flex-direction: column; } }

  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  .sm { font-size: clamp(26px, 3vw, 36px); margin-bottom: 20px; }
  .obj { font-size: 17px; line-height: 1.45; }
  .obj li { grid-template-columns: 34px 1fr; }
  .obj li::before { width: 34px; height: 17px; filter: brightness(0); }

  .outcomes { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 860px) { .outcomes { grid-template-columns: 1fr; } }
  .outcomes details { border: 2px solid var(--lime); }
  .outcomes details[open] { background: rgba(234,246,101,.06); }
  .outcomes summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 52px 1fr 36px; gap: 12px; align-items: center; padding: 16px 18px; font-weight: 700; font-size: 18px; line-height: 1.3; }
  .outcomes summary::-webkit-details-marker { display: none; }
  .outcomes .n { font-weight: 900; font-size: 30px; color: var(--lime); }
  .pl { width: 32px; height: 32px; border-radius: 50%; background: var(--lime); color: var(--ink); display: grid; place-items: center; font-weight: 900; transition: transform .2s; }
  details[open] .pl { transform: rotate(45deg); }
  .outcomes dl { margin: 0; padding: 0 18px 18px 82px; display: grid; gap: 12px; }
  .outcomes dt { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--lime); }
  .outcomes dd { margin: 2px 0 0; font-size: 15px; color: rgba(255,255,255,.85); }
  @media (max-width: 520px) { .outcomes dl { padding-left: 18px; } }

  .features { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .features li { padding: 24px; display: grid; gap: 10px; align-content: start; border-top-width: 12px; }
  .features p { font-size: 16px; color: var(--muted); }
  .f0 { border-top-color: var(--blue) !important; } .f1 { border-top-color: var(--coral) !important; }
  .f2 { border-top-color: var(--yellow) !important; } .f3 { border-top-color: var(--peach) !important; }
  .features li:nth-child(odd) { transform: rotate(-.6deg); } .features li:nth-child(even) { transform: rotate(.6deg); }
  @media (max-width: 980px) { .features { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .features { grid-template-columns: 1fr; } .features li { transform: none !important; } }

  .dur { list-style: none; display: grid; gap: 0; border-left: 4px solid var(--ink); margin-left: 8px; }
  .dur li { position: relative; padding: 0 0 22px 26px; display: grid; gap: 6px; justify-items: start; }
  .dur li::before { content: ''; position: absolute; left: -12px; top: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--coral); border: var(--border); }
  .dur strong { line-height: 1.35; }
  .dur .chip { font-size: 13px; padding: 5px 10px; }

  .mats { list-style: none; display: grid; gap: 0; padding: 8px 20px; }
  .mats li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; font-size: 16px; line-height: 1.4; }
  .mats li + li { border-top: 1px solid #ddd; }
  .mats em { font-style: normal; font-weight: 700; font-size: 13px; text-align: right; flex: none; max-width: 40%; color: var(--blue-deep); }
  .mt { margin-top: 24px; }

  .evals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .evals div { display: grid; gap: 12px; align-content: start; }
  .evals .n { width: 44px; height: 44px; border-radius: 50%; background: var(--lime); color: var(--ink); display: grid; place-items: center; font-weight: 900; font-size: 20px; }
  .evals p { color: rgba(255,255,255,.85); font-size: 16px; }
  @media (max-width: 860px) { .evals { grid-template-columns: 1fr; } }
</style>
