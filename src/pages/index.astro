---
import { langs, defaultLang } from '../i18n/ui';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Videoactivism Academy</title>
    <meta http-equiv="refresh" content={`1; url=/${defaultLang}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ langs, defaultLang }}>
      let pick = defaultLang;
      try {
        const saved = localStorage.getItem('lang');
        const nav = (navigator.languages || [navigator.language]).map((l) => l.slice(0, 2).toLowerCase());
        pick = langs.includes(saved) ? saved : nav.find((l) => langs.includes(l)) || defaultLang;
      } catch {}
      location.replace(`/${pick}/`);
    </script>
  </head>
  <body style="background:#54E86D;font-family:system-ui;padding:24px">
    <a href="/sl/">Slovenščina</a> · <a href="/hr/">Hrvatski</a> · <a href="/en/">English</a>
  </body>
</html>
