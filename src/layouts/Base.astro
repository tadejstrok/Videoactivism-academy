---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Route without the language prefix, e.g. "modules/satire". */
  path?: string;
  title?: string;
  description?: string;
}
const { lang, path = '', title, description } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.description');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta name="theme-color" content="#54E86D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/web/Barber-Fill.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/web/Barber-Shadow.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/web/Barber-Right.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/web/Barber-Outline.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/web/Switzer-Regular.woff" as="font" type="font/woff" crossorigin />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={localePath(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={localePath('en', path)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header lang={lang} path={path} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
